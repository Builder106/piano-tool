{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/tests/**,docs/**,backend/README.md,backend/scripts/**,**/sklearn/**,**/scikit_learn-*.dist-info/**}"
    }
  },
  "buildCommand": "pip install -r backend/requirements.txt && pip install basic-pitch==0.4.0 --no-deps && pip uninstall -y scikit-learn",
  "devCommand": "uvicorn backend.app.main:app --reload"
}
