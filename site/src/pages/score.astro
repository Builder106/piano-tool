---
import Base from '../layouts/Base.astro';
import { site, units } from '../data/site';
---
<Base
  title="The score"
  description="Every page of the Piano Tool site as a plain list: the eight notes of stage one, C4 to C5, with what each one covers, plus the colophon."
>
  <article class="desk desk--score">
    <p class="desk__meta" data-reveal="fade" data-intro><span>Stage one</span><span>Measures 1 and 2</span><span>8 notes</span></p>
    <h1 class="desk__title" data-split="lines" data-intro>The score.</h1>
    <p class="lede" data-split="lines" data-intro data-delay="0.15">The whole site as a list. Every note is a page.</p>
    <ol class="score">
      {units.map((u) => (
        <li>
          <a class="score__row" href={u.route} data-midi={u.midi}>
            <span class="score__note">{u.note}</span>
            <span class="score__title">{u.label}</span>
            <span class="score__midi">MIDI {u.midi}</span>
            <span class="score__key" aria-hidden="true">{u.key}</span>
          </a>
        </li>
      ))}
    </ol>
    <section class="colophon" aria-labelledby="colophon-title">
      <h2 id="colophon-title">Colophon</h2>
      <p>
        Set in Cormorant Garamond and IBM Plex Sans, the app's own typefaces, with music glyphs from
        Bravura. The keyboard was modelled and rendered in Blender after the app's 61 key layout, C2 to C7.
        The noteheads and figures were drawn in Glaxnimate from the app's glyph code. Built with Astro and
        GSAP. Pitch detection on this site is a browser port of the app's YIN detector.
      </p>
      <p>
        Made by {site.author}. <a class="link" href={site.repo} rel="noopener">Source on GitHub</a>.
      </p>
    </section>
  </article>
</Base>
