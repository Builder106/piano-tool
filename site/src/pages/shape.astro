---
import Base from '../layouts/Base.astro';
import Unit from '../components/Unit.astro';
import { unitByMidi } from '../data/site';

const unit = unitByMidi.get(65)!;
// The Glaxnimate notehead sheet (design/glaxnimate/noteheads.svg), one state per column.
const states = [
  { id: 'upcoming', name: 'Upcoming', shape: 'Hollow outline' },
  { id: 'active', name: 'Due now', shape: 'Filled, with a ring' },
  { id: 'perfect', name: 'Perfect', shape: 'Filled, ring kept' },
  { id: 'good', name: 'Good', shape: 'Filled' },
  { id: 'okay', name: 'Okay', shape: 'Filled' },
  { id: 'missed', name: 'Missed', shape: 'Hollow, struck through' },
];
---
<Base title="Shape before colour" description={unit.description} note={unit.midi}>
  <Unit unit={unit}>
    <p class="lede" slot="lede" data-split="lines" data-intro data-delay="0.15">
      A note's state is drawn as a shape first, so the staff still reads with no colour at all.
    </p>
    <figure class="figure figure--states" data-states>
      <ul class="states">
        {states.map((s) => (
          <li class={`state state--${s.id}`}>
            <svg viewBox="-20 -20 40 40" aria-hidden="true" focusable="false">
              <circle class="state__ring" r="9.36" />
              <ellipse class="state__oval" rx="6.5" ry="5" transform="rotate(-20.05)" />
              <line class="state__strike" x1="-9.12" y1="6.24" x2="9.12" y2="-6.24" />
            </svg>
            <span class="state__name">{s.name}</span>
            <span class="state__shape">{s.shape}</span>
          </li>
        ))}
      </ul>
      <figcaption>
        <button class="toggle toggle--inline" type="button" aria-pressed="false" data-greyscale>See it without colour</button>
      </figcaption>
    </figure>
    <div class="prose">
      <p>
        Hits are graded by timing. A perfect hit keeps its ring, a good hit is solid green, and an okay
        hit is amber. A note you never play stays hollow and gets struck through.
      </p>
      <p>
        An earlier build told a hit from a miss only by green against red. Roughly one man in twelve has
        red-green colour blindness, and for him the two looked the same. Filled against hollow is ordinary
        music notation, so the fix cost nothing and made the staff read more like a score.
      </p>
    </div>
  </Unit>
</Base>
