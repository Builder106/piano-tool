---
// The practice HUD, as in the app: stage, tempo and progress on the left; how you play on the
// right (the app's settings offer microphone, MIDI, or both). Persisted across pages.
import { site, units } from '../data/site';

interface Props { note?: number }
const idx = units.findIndex((u) => u.midi === Astro.props.note);
const progress = idx >= 0 ? `Note ${idx + 1} of ${units.length}` : `Stage ${site.stage.number}`;
---
<header class="hud" id="hud" transition:persist="hud">
  <a class="hud__home" href="/" data-hud-home>{site.name}</a>
  <p class="hud__stage">
    <span>Stage {site.stage.number}</span>
    <span>{site.stage.title}</span>
    <span class="hud__tempo"><span class="smufl" aria-hidden="true">{''}</span><span class="sr-only">Quarter note</span>&nbsp;=&nbsp;{site.stage.tempo}</span>
    <span class="hud__progress" data-progress>{progress}</span>
  </p>
  <div class="hud__play" role="group" aria-label="Play with">
    <span class="hud__label" aria-hidden="true">Play with</span>
    <button class="toggle" type="button" data-input="keys" aria-pressed="true" title="Letter keys A to K play the stage">Keys</button>
    <button class="toggle" type="button" data-input="mic" aria-pressed="false" title="Listen to your piano through the microphone">Mic</button>
    <button class="toggle" type="button" data-input="midi" aria-pressed="false" title="Read a MIDI keyboard" hidden>MIDI</button>
    <button class="toggle" type="button" data-input="sound" aria-pressed="false" title="Play a tone for each key">Sound</button>
  </div>
  <a class="hud__score" href="/score/">Score</a>
  <p class="hud__hear" data-hear aria-live="polite"></p>
</header>
<div class="toast" id="toast" role="status" aria-live="polite" transition:persist="toast">
  <svg class="toast__head" viewBox="-14 -14 28 28" aria-hidden="true" focusable="false">
    <ellipse cx="0" cy="0" rx="6.5" ry="5" transform="rotate(-20.05)" />
    <line x1="-9.12" y1="6.24" x2="9.12" y2="-6.24" />
  </svg>
  <span data-toast-text></span>
</div>
